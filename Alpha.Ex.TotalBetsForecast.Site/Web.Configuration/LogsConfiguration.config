<LogsConfiguration>
  <Logs SensitiveParams="password,pwd,security"
        SensitiveReplacement="*">
    <Log type="Info">
      <Messages>
        <Message text="Not casino user" />
        <Message text="Not a casino user" />
        <Message text="Not casino's Customer" />
        <Message text="This username not exists in Casino" />
        <Message text="Thread was being aborted" />
      </Messages>
    </Log>
    <Log type="Warning">
      <Messages>
        <Message text="" />
      </Messages>
    </Log>
    <Log type="Critical">
      <Messages/>
    </Log>
  </Logs>
</LogsConfiguration>
