<?xml version="1.0" encoding="utf-8"?>

<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=169433
  -->

<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="SecurityCodeSection" type="Fanex.Razorbill.Security.Configurations.SecurityCodeSection, Fanex.Razorbill.Security" />
  </configSections>
  <appSettings file="Web.AppSettings.config" />
  <SecurityCodeSection configSource="SecurityCode.config" />
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.DbSettingProviderExtension.XmlDbSettingProvider3, Fanex.Data.DbSettingProviderExtension" resourcePath="~/Web.Configuration/StoreProcedure" enableWatching="0" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <system.web>
    <compilation debug="true" targetFramework="4.0">
      <assemblies>
        <add assembly="System.Web.Mvc, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35, processorArchitecture=MSIL" />
      </assemblies>
    </compilation>    
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer> 
  
  <runtime> 
  
         <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1"> 
  
                <dependentAssembly> 
  
                       <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" /> 
  
                       <bindingRedirect oldVersion="0.0.0.0-4.5.0.0" newVersion="4.5.0.0" /> 
  
                </dependentAssembly> 
  
                <dependentAssembly> 
  
                       <assemblyIdentity name="NPOI" publicKeyToken="0df73ec7942b34e1" culture="neutral" /> 
  
                       <bindingRedirect oldVersion="0.0.0.0-2.0.6.0" newVersion="2.0.6.0" /> 
  
                </dependentAssembly> 
  
                <dependentAssembly> 
  
                       <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" culture="neutral" /> 
  
                       <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0" /> 
  
                </dependentAssembly> 
  
                <dependentAssembly> 
  
                       <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" culture="neutral" /> 
  
                       <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" /> 
  
                </dependentAssembly> 
  
         </assemblyBinding> 
  
  </runtime>

</configuration>
